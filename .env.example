# ==============================================================================
# AEGIS Backend Environment Configuration Example
# Copy this file to .env before starting the server.
# NEVER commit the real .env file or credentials to version control.
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=5000
HOST=0.0.0.0
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000,http://localhost:5000,http://127.0.0.1:5000

# Security and Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
SOS_RATE_LIMIT_MAX=5
SOS_RATE_LIMIT_WINDOW_MS=60000

# Database Configuration (PostgreSQL + PostGIS)
# When running via Docker Compose: postgresql://aegis_user:aegis_secure_password@localhost:5432/aegis_db
DATABASE_URL=postgresql://aegis_user:aegis_secure_password@localhost:5432/aegis_db
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# Authentication
# Set to 'true' to enable development mock authentication (header: x-dev-user-id / Bearer dev-token)
# MUST BE 'false' or unset in production!
DEV_MOCK_AUTH=true

# Firebase Admin SDK (Production Phone OTP Verification)
FIREBASE_PROJECT_ID=aegis-safety-dev
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@aegis-safety-dev.iam.gserviceaccount.com
# Format: multiline string with escaped newlines \n
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC7\n-----END PRIVATE KEY-----\n"

# SMS Emergency Alert Provider (fast2sms | twilio | mock)
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_SENDER_ID=AEGISS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Push Notifications (fcm | mock)
PUSH_PROVIDER=mock
FCM_SERVER_KEY=

# Maps & Geocoding Provider (osm | google | mock)
MAPS_PROVIDER=osm
GOOGLE_MAPS_API_KEY=

# Routing Provider (osrm | google | fallback)
ROUTING_PROVIDER=osrm
OSRM_BASE_URL=https://router.project-osrm.org

# Live Location Sessions
LOCATION_SESSION_DEFAULT_DURATION_MINUTES=60
LOCATION_SESSION_MAX_DURATION_MINUTES=240
LOCATION_PUBLIC_BASE_URL=https://aegis-safety.app/live

# Default Geographic Focus (Chennai, Tamil Nadu)
DEFAULT_CITY=Chennai
DEFAULT_LATITUDE=13.0827
DEFAULT_LONGITUDE=80.2707
DEFAULT_SEARCH_RADIUS_METERS=5000
